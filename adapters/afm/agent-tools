#!/bin/zsh
# adapters/afm/agent-tools — on-device MCP + LSP tool-augmented answers via the AFM agent CLI.
# Usage:
#   adapters/afm/agent-tools "Fix the bug in main.py"
#   adapters/afm/agent-tools mcp-list "python3 /path/to/server.py"
#   adapters/afm/agent-tools lsp-diag /path/to/file.py
# First run compiles the bridge (public FoundationModels API); subsequent runs
# reuse the binary. Safe/read-only: no persistence, no network egress.
set -u
DIR="${0:A:h}"
BIN="$DIR/.afm-agent-tools-bin"
SRC="$DIR/afm-agent-tools.swift"

if [ ! -x "$BIN" ] || [ "$SRC" -nt "$BIN" ]; then
  echo "building afm-agent-tools (one-time)..." >&2
  xcrun swiftc -parse-as-library -O -o "$BIN" "$SRC" || { echo "build failed" >&2; exit 1; }
fi
if [ $# -eq 0 ]; then echo "usage: agent-tools \"<question>\"" >&2; exit 2; fi
"$BIN" "$@"
