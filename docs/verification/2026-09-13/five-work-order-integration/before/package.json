{
  "name": "nisi",
  "version": "0.2.0-private.0",
  "private": true,
  "description": "A Node.js workflow orchestrator for AI-assisted coding, with bounded repairs and validated run reports.",
  "license": "UNLICENSED",
  "author": "Louis Calata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louiscalata/nisi.git"
  },
  "homepage": "https://github.com/louiscalata/nisi#readme",
  "bugs": {
    "url": "https://github.com/louiscalata/nisi/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/require-node.cjs && node --test tests/*.test.mjs",
    "check:structural": "node scripts/require-node.cjs && node scripts/structural-check.mjs",
    "check": "npm run check:structural && npm test",
    "bench": "node scripts/bench.mjs",
    "ab:purity": "node scripts/ab-purity.mjs contracts/structural-fixtures.json ${AFM:-afm}",
    "check:static": "node scripts/require-node.cjs && node tools/check-side-effects.mjs",
    "example:workflow": "node scripts/require-node.cjs && node examples/workflow.mjs",
    "preflight": "node scripts/require-node.cjs",
    "example:local-model": "node scripts/require-node.cjs && node examples/local-model-workflow.mjs",
    "test:types": "tsc --noEmit --ignoreConfig --strict --exactOptionalPropertyTypes --noUncheckedIndexedAccess --module NodeNext --target ES2022 --types node tests/private-consumer/*.mts",
    "check:private-package": "node scripts/check-private-package.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "canonical-json",
    "capability-security",
    "static-analysis",
    "mutation-testing",
    "foundation-models"
  ],
  "main": "./index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.mjs"
    },
    "./workflow": {
      "types": "./types/workflow.d.ts",
      "default": "./workflow/engine.mjs"
    },
    "./policy": {
      "types": "./types/policy.d.ts",
      "default": "./policy/file-access.mjs"
    },
    "./serialization": {
      "types": "./types/serialization.d.ts",
      "default": "./serialization/canonical-json-v1.mjs"
    },
    "./adapters/apple-foundation-models": {
      "types": "./types/apple-foundation-models.d.ts",
      "default": "./adapters/apple-foundation-models.mjs"
    },
    "./adapters/local-chat": {
      "types": "./types/local-chat.d.ts",
      "default": "./adapters/local-chat.mjs"
    },
    "./index.mjs": {
      "types": "./types/index.d.ts",
      "default": "./index.mjs"
    },
    "./workflow/engine.mjs": {
      "types": "./types/workflow.d.ts",
      "default": "./workflow/engine.mjs"
    },
    "./workflow/contracts.mjs": {
      "types": "./types/contracts.d.ts",
      "default": "./workflow/contracts.mjs"
    },
    "./policy/file-access.mjs": {
      "types": "./types/policy.d.ts",
      "default": "./policy/file-access.mjs"
    },
    "./serialization/canonical-json-v1.mjs": {
      "types": "./types/serialization.d.ts",
      "default": "./serialization/canonical-json-v1.mjs"
    },
    "./adapters/apple-foundation-models.mjs": {
      "types": "./types/apple-foundation-models.d.ts",
      "default": "./adapters/apple-foundation-models.mjs"
    },
    "./adapters/local-chat.mjs": {
      "types": "./types/local-chat.d.ts",
      "default": "./adapters/local-chat.mjs"
    },
    "./canonical/canonical-json-v1.mjs": {
      "types": "./types/canonical.d.ts",
      "default": "./canonical/canonical-json-v1.mjs"
    },
    "./gate/content-consent.mjs": {
      "types": "./types/content-consent.d.ts",
      "default": "./gate/content-consent.mjs"
    },
    "./gate/afm-content-executor.mjs": {
      "types": "./types/afm-content-executor.d.ts",
      "default": "./gate/afm-content-executor.mjs"
    },
    "./*": "./*"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "adapters/apple-foundation-models.mjs",
    "adapters/local-chat.mjs",
    "canonical/canonical-json-v1.mjs",
    "gate/afm-content-executor.mjs",
    "gate/content-consent.mjs",
    "hosts/repository/snapshot-contract.mjs",
    "hosts/swift-verifier/owned-child.mjs",
    "hosts/swift-verifier/protocol.mjs",
    "index.mjs",
    "policy/file-access.mjs",
    "serialization/canonical-json-v1.mjs",
    "workflow/contracts.mjs",
    "workflow/engine.mjs",
    "types/afm-content-executor.d.ts",
    "types/apple-foundation-models.d.ts",
    "types/canonical.d.ts",
    "types/content-consent.d.ts",
    "types/contracts.d.ts",
    "types/index.d.ts",
    "types/local-chat.d.ts",
    "types/policy.d.ts",
    "types/serialization.d.ts",
    "types/workflow.d.ts"
  ]
}
