diff --git a/tests/journal-maintenance-v1.test.mjs b/tests/journal-maintenance-v1.test.mjs
--- a/tests/journal-maintenance-v1.test.mjs
+++ b/tests/journal-maintenance-v1.test.mjs
@@ -27,6 +27,35 @@ test('malformed envelopes, hidden fields, symbols and accessors refuse without
   assert.equal(calls, 0);
 });

+test('ordinary and revoked proxies are refused before any proxy trap at every owner boundary', () => {
+  const opened = open(memfs());
+  let traps = 0;
+  const trap = () => { traps++; throw Error('proxy trap must not run'); };
+  const top = new Proxy({owner: opened.owner, now: 100}, {get: trap, ownKeys: trap,
+    getOwnPropertyDescriptor: trap, getPrototypeOf: trap});
+  assertResult(maintainJournalOwner(top), 'REFUSED', 'INVALID_INPUT', null);
+  const revokedTop = Proxy.revocable({owner: opened.owner, now: 100}, {});
+  revokedTop.revoke();
+  assertResult(maintainJournalOwner(revokedTop.proxy), 'REFUSED', 'INVALID_INPUT', null);
+
+  const config = new Proxy({...CONFIG}, {get: trap, ownKeys: trap,
+    getOwnPropertyDescriptor: trap, getPrototypeOf: trap});
+  const configResult = open(memfs(), 100, config);
+  assert.equal(configResult.status, 'REFUSED'); assert.equal(configResult.reason, 'INVALID_INPUT');
+  const revokedConfig = Proxy.revocable({...CONFIG}, {});
+  revokedConfig.revoke();
+  const revokedConfigResult = open(memfs(), 100, revokedConfig.proxy);
+  assert.equal(revokedConfigResult.status, 'REFUSED'); assert.equal(revokedConfigResult.reason, 'INVALID_INPUT');
+
+  const nestedEntry = new Proxy(entry('proxy-entry'), {get: trap, ownKeys: trap,
+    getOwnPropertyDescriptor: trap, getPrototypeOf: trap});
+  const nestedResult = record(opened.owner, nestedEntry, 100);
+  assert.equal(nestedResult.status, 'REFUSED'); assert.equal(nestedResult.reason, 'ENTRY');
+  const revokedEntry = Proxy.revocable(entry('revoked-entry'), {});
+  revokedEntry.revoke();
+  const revokedResult = record(opened.owner, revokedEntry.proxy, 100);
+  assert.equal(revokedResult.status, 'REFUSED'); assert.equal(revokedResult.reason, 'ENTRY');
+  assert.equal(traps, 0);
+});
