{
  "name": "nisi",
  "version": "0.1.0",
  "description": "A Node.js workflow orchestrator for AI-assisted coding, with bounded repairs and validated run reports.",
  "license": "Apache-2.0",
  "author": "Louis Calata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louiscalata/nisi.git"
  },
  "homepage": "https://github.com/louiscalata/nisi#readme",
  "bugs": {
    "url": "https://github.com/louiscalata/nisi/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/require-node.cjs && node --test tests/*.test.mjs",
    "check:structural": "node scripts/require-node.cjs && node scripts/structural-check.mjs",
    "check": "npm run check:structural && npm test",
    "bench": "node scripts/bench.mjs",
    "ab:purity": "node scripts/ab-purity.mjs contracts/structural-fixtures.json ${AFM:-afm}",
    "check:static": "node scripts/require-node.cjs && node tools/check-side-effects.mjs",
    "example:workflow": "node scripts/require-node.cjs && node examples/workflow.mjs",
    "preflight": "node scripts/require-node.cjs",
    "example:local-model": "node scripts/require-node.cjs && node examples/local-model-workflow.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "keywords": [
    "canonical-json",
    "capability-security",
    "static-analysis",
    "mutation-testing",
    "foundation-models"
  ],
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./workflow": "./workflow/engine.mjs",
    "./policy": "./policy/file-access.mjs",
    "./serialization": "./serialization/canonical-json-v1.mjs",
    "./adapters/apple-foundation-models": "./adapters/apple-foundation-models.mjs",
    "./adapters/local-chat": "./adapters/local-chat.mjs",
    "./*": "./*"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "error"
    }
  }
}
