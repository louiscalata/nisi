{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.invalid/private/schemas/stage5/assurance-exhaustive-replay-oracle.v1.json",
  "title": "Veritas inert M4.7 frozen-set oracle agreement result",
  "description": "Structural fixture shape only. Runtime validation additionally recomputes the frozen oracle universe, registered check set, pre-planner freeze, change-vector and plan digests, requires every registered check exactly once in canonical order with one reason path, forbids caller-supplied missed or extra sets, and refuses any plan smaller than the frozen set. This schema proves no executed replay, check outcome, event authenticity, or M4, M4.7, E15, or official E16 credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "status",
    "profile",
    "graphDigest",
    "universeDigest",
    "checkSetDigest",
    "freezeDigest",
    "mode",
    "includedCheckIds",
    "knownChange",
    "unresolvedDependency",
    "trace",
    "authorizing",
    "protectedAuthorityVerified",
    "generatedArtifactExecuted",
    "runtimeDependencyObserved",
    "realEventObserved",
    "mayRecall",
    "mayReplay",
    "mayExecute",
    "mayPromote",
    "mayInstall",
    "filesystemMutated",
    "networkRequested",
    "subprocessStarted",
    "dynamicLoadAttempted",
    "coordinatorMutated",
    "officialE15Credit",
    "officialE16Credit",
    "m4Credit",
    "resultDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "M47_ORACLE_AGREEMENT_RESULT_FIXTURE"
    },
    "status": {
      "const": "DERIVED_M47_INERT_FROZEN_SET_PLAN_ONLY"
    },
    "profile": {
      "const": "veritas-m47-inert-frozen-set-plan-oracle-v1"
    },
    "graphDigest": {
      "$ref": "#/$defs/sha256"
    },
    "universeDigest": {
      "$ref": "#/$defs/sha256"
    },
    "checkSetDigest": {
      "$ref": "#/$defs/sha256"
    },
    "freezeDigest": {
      "$ref": "#/$defs/sha256"
    },
    "mode": {
      "const": "FROZEN_SET_FALLBACK"
    },
    "includedCheckIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixtureId"
      }
    },
    "knownChange": {
      "$ref": "#/$defs/armAgreement"
    },
    "unresolvedDependency": {
      "$ref": "#/$defs/armAgreement"
    },
    "trace": {
      "const": [
        "VALIDATE_FROZEN_ORACLE",
        "VALIDATE_REGISTERED_CHECKS",
        "VALIDATE_PRE_PLANNER_FREEZE",
        "VALIDATE_CHANGE_VECTORS",
        "DERIVE_FROZEN_SET_PLANS",
        "COMPARE_ORACLE_AND_PLANS",
        "RETURN_INERT"
      ]
    },
    "authorizing": {
      "const": false
    },
    "protectedAuthorityVerified": {
      "const": false
    },
    "generatedArtifactExecuted": {
      "const": false
    },
    "runtimeDependencyObserved": {
      "const": false
    },
    "realEventObserved": {
      "const": false
    },
    "mayRecall": {
      "const": false
    },
    "mayReplay": {
      "const": false
    },
    "mayExecute": {
      "const": false
    },
    "mayPromote": {
      "const": false
    },
    "mayInstall": {
      "const": false
    },
    "filesystemMutated": {
      "const": false
    },
    "networkRequested": {
      "const": false
    },
    "subprocessStarted": {
      "const": false
    },
    "dynamicLoadAttempted": {
      "const": false
    },
    "coordinatorMutated": {
      "const": false
    },
    "officialE15Credit": {
      "const": false
    },
    "officialE16Credit": {
      "const": false
    },
    "m4Credit": {
      "const": false
    },
    "resultDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*)*$"
    },
    "reasonPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "reasonKind",
        "pathNodes"
      ],
      "properties": {
        "checkId": {
          "$ref": "#/$defs/fixtureId"
        },
        "reasonKind": {
          "enum": [
            "DIRECT_GRAPH_INTERSECTION",
            "UNRESOLVED_DEPENDENCY_FALLBACK"
          ]
        },
        "pathNodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "excludedCheckReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "reason"
      ],
      "properties": {
        "checkId": {
          "$ref": "#/$defs/fixtureId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "armAgreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vectorKind",
        "changeDigest",
        "planDigest",
        "reasonKind",
        "reasonPaths",
        "excludedCheckReasons",
        "missedCheckIds",
        "extraCheckIds"
      ],
      "properties": {
        "vectorKind": {
          "enum": [
            "KNOWN_CHANGE",
            "UNRESOLVED_DEPENDENCY"
          ]
        },
        "changeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "planDigest": {
          "$ref": "#/$defs/sha256"
        },
        "reasonKind": {
          "enum": [
            "DIRECT_GRAPH_INTERSECTION",
            "UNRESOLVED_DEPENDENCY_FALLBACK"
          ]
        },
        "reasonPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/reasonPath"
          }
        },
        "excludedCheckReasons": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/excludedCheckReason"
          }
        },
        "missedCheckIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fixtureId"
          }
        },
        "extraCheckIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fixtureId"
          }
        }
      }
    }
  }
}
