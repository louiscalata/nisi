{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.invalid/private/schemas/stage5/git-tree-delta.v1.json",
  "title": "Veritas inert exact structured Git tree-delta derivation result",
  "description": "Structural result shape only. Acceptance requires the private runtime to freshly verify raw Git objects and the active base, validate every operation against one base, derive the final byte-bearing tree in memory, and repeat raw verification before return. This schema is not an ingest verifier, patch parser, staging authority, or release evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "status",
    "profile",
    "operationId",
    "requestDigest",
    "gitBaseRequestDigest",
    "gitBaseManifestResultDigest",
    "baseBindingDigest",
    "commitObjectId",
    "rootTreeObjectId",
    "refRevisionToken",
    "snapshotObjectClosureDigest",
    "operationsDigest",
    "baseTreeDigest",
    "baseInventoryDigest",
    "finalInventoryDigest",
    "candidateDigest",
    "operationCount",
    "addCount",
    "replaceCount",
    "deleteCount",
    "chmodCount",
    "baseFileCount",
    "baseTotalBytes",
    "finalFileCount",
    "finalTotalBytes",
    "finalFiles",
    "atomicCheckIds",
    "repeatedRuns",
    "denominatorNegativeControls",
    "freshBaseReverified",
    "protectedRef",
    "authorizing",
    "mayCreateDecision",
    "mayStage",
    "mayPromote",
    "mayInstall",
    "mayExecute",
    "gitSubprocessInvoked",
    "textPatchParsed",
    "filesystemMutated",
    "limitations",
    "resultDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "GIT_TREE_DELTA_DERIVATION" },
    "status": { "const": "DERIVED_INERT" },
    "profile": {
      "const": "veritas-git-tree-delta-v1:single-base+one-op-per-path+simultaneous+inert"
    },
    "operationId": { "$ref": "#/$defs/uuidV4" },
    "requestDigest": { "$ref": "#/$defs/sha256" },
    "gitBaseRequestDigest": { "$ref": "#/$defs/sha256" },
    "gitBaseManifestResultDigest": { "$ref": "#/$defs/sha256" },
    "baseBindingDigest": { "$ref": "#/$defs/sha256" },
    "commitObjectId": { "$ref": "#/$defs/sha1" },
    "rootTreeObjectId": { "$ref": "#/$defs/sha1" },
    "refRevisionToken": { "$ref": "#/$defs/sha256" },
    "snapshotObjectClosureDigest": { "$ref": "#/$defs/sha256" },
    "operationsDigest": { "$ref": "#/$defs/sha256" },
    "baseTreeDigest": { "$ref": "#/$defs/sha256" },
    "baseInventoryDigest": { "$ref": "#/$defs/sha256" },
    "finalInventoryDigest": { "$ref": "#/$defs/sha256" },
    "candidateDigest": { "$ref": "#/$defs/sha256" },
    "operationCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "addCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "replaceCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "deleteCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "chmodCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "baseFileCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "baseTotalBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
    "finalFileCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "finalTotalBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
    "finalFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resultFile" }
    },
    "atomicCheckIds": {
      "type": "array",
      "minItems": 59,
      "maxItems": 59,
      "prefixItems": [
        { "const": "M37-D01-ALL-OPERATIONS" },
        { "const": "M37-D02-DETERMINISTIC-REPLAY" },
        { "const": "M37-D03-FILE-TO-DIRECTORY-PREFIX" },
        { "const": "M37-D04-DIRECTORY-TO-FILE-PREFIX" },
        { "const": "M37-D05-UNSORTED-OPERATIONS" },
        { "const": "M37-D06-DUPLICATE-OPERATION-PATH" },
        { "const": "M37-D07-ADD-EXISTING" },
        { "const": "M37-D08-ADD-PRIOR-NONNULL" },
        { "const": "M37-D09-REPLACE-ABSENT" },
        { "const": "M37-D10-PRIOR-MODE-SUBSTITUTION" },
        { "const": "M37-D11-PRIOR-BLOB-OID-SUBSTITUTION" },
        { "const": "M37-D12-PRIOR-RAW-SHA256-SUBSTITUTION" },
        { "const": "M37-D13-PRIOR-CONTENT-SHA256-SUBSTITUTION" },
        { "const": "M37-D14-PRIOR-LENGTH-SUBSTITUTION" },
        { "const": "M37-D15-REPLACE-NOOP" },
        { "const": "M37-D16-DELETE-ABSENT" },
        { "const": "M37-D17-DELETE-NEXT-NONNULL" },
        { "const": "M37-D18-CHMOD-ABSENT" },
        { "const": "M37-D19-CHMOD-CONTENT-CHANGED" },
        { "const": "M37-D20-CHMOD-MODE-UNCHANGED" },
        { "const": "M37-D21-NONCANONICAL-BASE64" },
        { "const": "M37-D22-NEXT-LENGTH-MISMATCH" },
        { "const": "M37-D23-NEXT-DIGEST-MISMATCH" },
        { "const": "M37-D24-PATH-TRAVERSAL" },
        { "const": "M37-D25-PATH-BACKSLASH" },
        { "const": "M37-D26-PATH-INVALID-UNICODE" },
        { "const": "M37-D27-PATH-NON-NFC" },
        { "const": "M37-D28-PATH-PORTABLE-COLLISION" },
        { "const": "M37-D29-PATH-RESERVED-NAMESPACE" },
        { "const": "M37-D30-PATH-TRAILING-DOT-SPACE" },
        { "const": "M37-D31-FINAL-PREFIX-COLLISION" },
        { "const": "M37-D32-MODE-UNSUPPORTED" },
        { "const": "M37-D33-EMPTY-OPERATIONS" },
        { "const": "M37-D34-EMPTY-FINAL-TREE" },
        { "const": "M37-D35-OPERATION-LIMIT" },
        { "const": "M37-D36-PATH-COMPONENT-LIMIT" },
        { "const": "M37-D37-BYTE-LIMIT" },
        { "const": "M37-D38-BASE-REQUEST-SUBSTITUTION" },
        { "const": "M37-D39-MANIFEST-RESULT-SUBSTITUTION" },
        { "const": "M37-D40-FORGED-STANDALONE-SUMMARY" },
        { "const": "M37-D41-REF-CHANGED" },
        { "const": "M37-D42-REF-A-B-A" },
        { "const": "M37-D43-OBJECT-CHANGED" },
        { "const": "M37-D44-OBJECT-CLOSURE-EXPANDED" },
        { "const": "M37-D45-OBJECT-CLOSURE-REMOVED" },
        { "const": "M37-D46-COORDINATOR-BASE-SUBSTITUTION" },
        { "const": "M37-D47-SHARED-BLOB-PATH-ISOLATION" },
        { "const": "M37-D48-CROSS-DOMAIN-DIGEST-SUBSTITUTION" },
        { "const": "M37-D49-FINAL-DIGEST-MISMATCH" },
        { "const": "M37-D50-RESULT-TAMPER" },
        { "const": "M37-D51-FAULT-AFTER-VALIDATION" },
        { "const": "M37-D52-FAULT-AFTER-DERIVATION" },
        { "const": "M37-D53-FAULT-BEFORE-FINAL-VERIFY" },
        { "const": "M37-D54-FAULT-BEFORE-RETURN" },
        { "const": "M37-D55-FIXTURE-LANE-REFUSAL" },
        { "const": "M37-D56-ZERO-EFFECTS" },
        { "const": "M37-D57-MALFORMED-UUID" },
        { "const": "M37-D58-AGGREGATE-BYTE-LIMIT" },
        { "const": "M37-D59-PATH-TOTAL-LIMIT" }
      ],
      "items": false
    },
    "repeatedRuns": { "const": 2 },
    "denominatorNegativeControls": { "const": 5 },
    "freshBaseReverified": { "const": true },
    "protectedRef": { "const": false },
    "authorizing": { "const": false },
    "mayCreateDecision": { "const": false },
    "mayStage": { "const": false },
    "mayPromote": { "const": false },
    "mayInstall": { "const": false },
    "mayExecute": { "const": false },
    "gitSubprocessInvoked": { "const": false },
    "textPatchParsed": { "const": false },
    "filesystemMutated": { "const": false },
    "limitations": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "prefixItems": [
        { "const": "SELF_ADMINISTERED_IN_MEMORY_FIXTURE_ONLY" },
        { "const": "NONCALLABLE_OUTSIDE_BOUNDED_TEST_LANE" },
        { "const": "STRUCTURED_REGULAR_FILE_OPERATIONS_ONLY" },
        { "const": "ONE_OPERATION_PER_CANONICAL_PATH_AGAINST_ONE_EXACT_BASE" },
        { "const": "SIMULTANEOUS_DERIVATION_NO_INTERMEDIATE_TREE_AUTHORITY" },
        { "const": "NO_TEXTUAL_GIT_PATCH_PARSING" },
        { "const": "NO_LIVE_REPOSITORY_CHECKOUT_INDEX_OR_WORKTREE_MUTATION" },
        { "const": "NO_RENAME_COPY_MERGE_CONFLICT_HISTORY_PACKFILE_OR_ALTERNATE_SUPPORT" },
        { "const": "NO_PROTECTED_REF_SIGNED_COMMIT_RACE_PROOF_OR_CROSS_PLATFORM_CUSTODY_CLAIM" },
        { "const": "SHA1_GIT_OBJECT_ID_COMPATIBILITY_NOT_SECURITY_ATTESTATION" },
        { "const": "NO_FILESYSTEM_WRITE_CHMOD_RENAME_OR_UNLINK" },
        { "const": "NO_STAGING_DECISION_CERTIFICATION_PROMOTION_INSTALLATION_OR_EXECUTION_AUTHORITY" },
        { "const": "NO_CONTAINMENT_OR_MALWARE_SAFETY_CLAIM" },
        { "const": "NO_M3_M4_PATENTABILITY_PRODUCTION_SIGNING_OR_RELEASE_CREDIT" }
      ],
      "items": false
    },
    "resultDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "resultFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "mode",
        "byteLength",
        "contentSha256"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!\\.(?:git|veritas)(?:/|$))[^\\u0000\\\\]+$"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
