{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.invalid/private/schemas/stage5/fi0-view.v1.json",
  "title": "Veritas FI-0 inert incident view",
  "description": "Structural fixture shape only. Runtime validation recomputes exact incident, evidence, event-chain, provenance-envelope, baseline-bundle, and view bindings. Every authority and effect field is declared false; only the separately stated fixture observations are measured. This view is not a decision, certificate, policy, promotion, repair, retrieval, recall, execution, or production artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "profile",
    "incidentId",
    "incidentDigest",
    "observationKey",
    "evidenceManifestDigest",
    "eventChainHeadDigest",
    "adjudicationState",
    "occurrenceCount",
    "historyEventCount",
    "sourceStreamHeadDigest",
    "historicalImportEnvelopeDigest",
    "baselineBundleDigest",
    "foundationOnly",
    "authorizing",
    "protectedAuthorityVerified",
    "mayCapture",
    "mayImport",
    "mayAdjudicate",
    "mayConfirm",
    "mayPromote",
    "mayRetrieve",
    "mayInjectContext",
    "mayRepair",
    "mayChangePolicy",
    "mayCertify",
    "mayRecall",
    "mayReplay",
    "mayInstall",
    "mayExecute",
    "filesystemMutated",
    "networkRequested",
    "subprocessStarted",
    "dynamicLoadAttempted",
    "coordinatorMutated",
    "generatedArtifactExecuted",
    "crossProjectRead",
    "baselineMutated",
    "viewDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "FI0_INCIDENT_VIEW" },
    "profile": { "const": "veritas-fi0-inert-incident-contract-v1" },
    "incidentId": { "$ref": "#/$defs/fixtureId" },
    "incidentDigest": { "$ref": "#/$defs/sha256" },
    "observationKey": { "$ref": "#/$defs/sha256" },
    "evidenceManifestDigest": { "$ref": "#/$defs/sha256" },
    "eventChainHeadDigest": { "$ref": "#/$defs/sha256" },
    "adjudicationState": { "const": "INCONCLUSIVE" },
    "occurrenceCount": { "const": 1 },
    "historyEventCount": { "const": 3 },
    "sourceStreamHeadDigest": { "$ref": "#/$defs/sha256" },
    "historicalImportEnvelopeDigest": { "$ref": "#/$defs/sha256" },
    "baselineBundleDigest": { "$ref": "#/$defs/sha256" },
    "foundationOnly": { "const": true },
    "authorizing": { "const": false },
    "protectedAuthorityVerified": { "const": false },
    "mayCapture": { "const": false },
    "mayImport": { "const": false },
    "mayAdjudicate": { "const": false },
    "mayConfirm": { "const": false },
    "mayPromote": { "const": false },
    "mayRetrieve": { "const": false },
    "mayInjectContext": { "const": false },
    "mayRepair": { "const": false },
    "mayChangePolicy": { "const": false },
    "mayCertify": { "const": false },
    "mayRecall": { "const": false },
    "mayReplay": { "const": false },
    "mayInstall": { "const": false },
    "mayExecute": { "const": false },
    "filesystemMutated": { "const": false },
    "networkRequested": { "const": false },
    "subprocessStarted": { "const": false },
    "dynamicLoadAttempted": { "const": false },
    "coordinatorMutated": { "const": false },
    "generatedArtifactExecuted": { "const": false },
    "crossProjectRead": { "const": false },
    "baselineMutated": { "const": false },
    "viewDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*)*$"
    }
  }
}
